# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'

# Listing
alias ls='eza --group-directories-first'
alias ll='eza -lh --group-directories-first --git --icons=auto'
alias la='eza -lah --group-directories-first --git --icons=auto'
alias lt='eza --tree --level=2 --group-directories-first --icons=auto'

# Concatenate
alias cat='bat --paging=never'
alias catp='bat --style=plain --paging=never'
alias rcat='command cat'

# top -> btop
alias top='btop'
alias rtop='command top'

# safety
alias cp='cp -iv'
alias mv='mv -iv'

# Removing files
alias rm='trash-put'
alias rrm='command rm -iv'
alias tl='trash-list'
alias tre='trash-restore'
alias te='trash-empty'

# Search
alias rg='rg --smart-case'
alias mkdir='mkdir -p'

# Make output readable
alias df='df -h'
alias du='du -sh'
alias free='free -h'
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'

# Git commands
alias gs='git status -sb'
alias ga='git add'
alias gc='git commit'
alias gcm='git commit -m'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias glog='git log --oneline --graph --decorate --all'

# Config and utilities
alias vim='nvim'
alias lg='lazygit'
alias zrc='nvim ~/.zshrc'
alias zal='nvim ~/.aliases'
alias szrc='source ~/.zshrc'
alias ff='fastfetch'
alias down='aria2c -x16 -s16 -k1M'

# global aliases (zsh only): `cmd H`, `cmd G foo`
# alias -g H='| head'
# alias -g T='| tail'
# alias -g G='| grep'
# alias -g L='| less'
# alias -g NE='2>/dev/null'
