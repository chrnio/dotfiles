[init]
    defaultBranch = main

[core]
    editor = nvim
    autocrlf = input
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    syntax-theme = TwoDark
    dark = true

    # One Dark: muted red/green backgrounds instead of the default neon ones
    minus-style = syntax "#3b2c31"
    minus-emph-style = syntax "#5a3138"
    plus-style = syntax "#2b3a2f"
    plus-emph-style = syntax "#3d5a38"
    whitespace-error-style = reverse "#e06c75"

    # moved lines (diff.colorMoved)
    map-styles = bold purple => syntax "#352f45", bold cyan => syntax "#283b40"

    # line numbers
    line-numbers-minus-style = "#e06c75"
    line-numbers-plus-style = "#98c379"
    line-numbers-zero-style = "#4b5263"
    line-numbers-left-style = "#3e4451"
    line-numbers-right-style = "#3e4451"

    # headers: green rules to match kitty/zellij borders
    file-style = bold "#61afef"
    file-decoration-style = "#98c379" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#3e4451" box
    hunk-header-file-style = "#61afef"
    hunk-header-line-number-style = "#e5c07b"
    commit-style = raw
    commit-decoration-style = "#98c379" box

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[diff]
    algorithm = histogram
    colorMoved = default

[merge]
    conflictstyle = zdiff3

[alias]
    s = status -sb
    lg = log --oneline --graph --decorate -15
    unstage = restore --staged
    last = log -1 HEAD

[user]
    name = Charan Vadapalli
    email = 289275369+chrnio@users.noreply.github.com
