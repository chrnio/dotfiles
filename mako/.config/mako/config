font=monospace 10

background-color=#000000
text-color=#d0d0d0

default-timeout=5000

border-color=#33ccff
border-size=2
border-radius=0

padding=8
margin=8
width=320
height=100

anchor=top-right
layer=overlay

icons=1
max-icon-size=32

progress-color=over #1a1a1a

[urgency=low]
border-color=#595959
text-color=#888888

[urgency=normal]
border-color=#33ccff
text-color=#d0d0d0

[urgency=high]
border-color=#00ff99
text-color=#ffffff
default-timeout=0
